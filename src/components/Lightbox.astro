---
interface Props {
  selector?: string;
}

const { selector = "#content img" } = Astro.props;
const dataSelector = selector;
---

<div
  class="lightbox"
  id="lightbox"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  data-selector={dataSelector}
  hidden
>
  <div class="lightbox-backdrop" data-lightbox-close></div>
  <button class="lightbox-toolbar lightbox-close" type="button" data-lightbox-close aria-label="关闭">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M18 6 6 18"></path>
      <path d="m6 6 12 12"></path>
    </svg>
  </button>
  <button class="lightbox-nav lightbox-prev" type="button" data-lightbox-prev aria-label="上一张" hidden>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="m15 18-6-6 6-6"></path>
    </svg>
  </button>
  <button class="lightbox-nav lightbox-next" type="button" data-lightbox-next aria-label="下一张" hidden>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="m9 18 6-6-6-6"></path>
    </svg>
  </button>
  <div class="lightbox-stage">
    <img class="lightbox-img" alt="" draggable="false" />
  </div>
  <div class="lightbox-counter"></div>
</div>

<script>
  if (!document.body.dataset.lightboxInited) {
    document.body.dataset.lightboxInited = "1";

    let gallery: HTMLImageElement[] = [];
    let current = -1;
    let scale = 1;
    let tx = 0;
    let ty = 0;
    let dragging = false;
    let startX = 0;
    let startY = 0;
    let startTx = 0;
    let startTy = 0;
    let lastFocused: HTMLElement | null = null;

    function getSelector(): string {
      const overlay = getOverlay();
      const attr = overlay?.getAttribute("data-selector");
      return attr || "#content img";
    }

    function clamp(value: number, min: number, max: number) {
      return Math.min(Math.max(value, min), max);
    }

    function getOverlay(): HTMLElement | null {
      return document.getElementById("lightbox");
    }

    function getImageEl(overlay: HTMLElement): HTMLImageElement | null {
      return overlay.querySelector(".lightbox-img");
    }

    function getStage(overlay: HTMLElement): HTMLElement | null {
      return overlay.querySelector(".lightbox-stage");
    }

    function applyTransform(overlay: HTMLElement, animate: boolean) {
      const img = getImageEl(overlay);
      const stage = getStage(overlay);
      if (!img) return;
      img.style.transition = animate ? "transform 0.15s ease-out" : "none";
      img.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
      if (scale > 1) {
        img.style.maxWidth = `${92 * scale}vw`;
        img.style.maxHeight = `${88 * scale}vh`;
        if (stage) {
          stage.style.maxWidth = `${92 * scale}vw`;
          stage.style.maxHeight = `${88 * scale}vh`;
        }
      } else {
        img.style.maxWidth = "";
        img.style.maxHeight = "";
        if (stage) {
          stage.style.maxWidth = "";
          stage.style.maxHeight = "";
        }
      }
    }

    function resetView(overlay: HTMLElement) {
      scale = 1;
      tx = 0;
      ty = 0;
      const img = getImageEl(overlay);
      const stage = getStage(overlay);
      if (img) {
        img.style.maxWidth = "";
        img.style.maxHeight = "";
      }
      if (stage) {
        stage.style.maxWidth = "";
        stage.style.maxHeight = "";
      }
      applyTransform(overlay, false);
    }

    function preload(index: number) {
      const img = gallery[index];
      if (img) {
        const im = new Image();
        im.src = img.currentSrc || img.src;
      }
    }

    function show(overlay: HTMLElement, index: number) {
      const img = gallery[index];
      if (!img) return;
      const view = getImageEl(overlay);
      if (!view) return;
      view.src = img.currentSrc || img.src;
      view.alt = img.alt || "";
      current = index;
      resetView(overlay);
      const counter = overlay.querySelector(".lightbox-counter");
      if (counter) counter.textContent = `${index + 1} / ${gallery.length}`;
      const prev = overlay.querySelector<HTMLButtonElement>(`[data-lightbox-prev]`);
      const next = overlay.querySelector<HTMLButtonElement>(`[data-lightbox-next]`);
      if (prev) prev.hidden = index === 0;
      if (next) next.hidden = index === gallery.length - 1;
      preload((index + 1) % gallery.length);
      preload((index - 1 + gallery.length) % gallery.length);
    }

    function zoom(overlay: HTMLElement, dir: number) {
      scale = clamp(scale + dir * 0.2, 1, 5);
      if (scale <= 1) {
        tx = 0;
        ty = 0;
      }
      applyTransform(overlay, true);
    }

    function openAt(index: number) {
      const overlay = getOverlay();
      if (!overlay) return;
      const imgs = Array.from(document.querySelectorAll<HTMLImageElement>(getSelector()));
      if (!imgs.length || index < 0 || index >= imgs.length) return;
      gallery = imgs;
      lastFocused = document.activeElement as HTMLElement | null;
      overlay.classList.add("open");
      overlay.removeAttribute("hidden");
      overlay.setAttribute("aria-hidden", "false");
      document.documentElement.classList.add("lightbox-lock");
      show(overlay, index);
      const closeBtn = overlay.querySelector<HTMLButtonElement>(`[data-lightbox-close]`);
      closeBtn?.focus();
      wireStage(overlay);
    }

    function close() {
      const overlay = getOverlay();
      if (!overlay) return;
      overlay.classList.remove("open");
      overlay.setAttribute("hidden", "");
      overlay.setAttribute("aria-hidden", "true");
      document.documentElement.classList.remove("lightbox-lock");
      const stage = getStage(overlay);
      if (stage) stage.classList.remove("dragging");
      try {
        lastFocused?.focus();
      } catch (err) {
        /* noop */
      }
    }

    function wireStage(overlay: HTMLElement) {
      const stage = getStage(overlay);
      if (!stage) return;
      if (!stage.dataset.wired) {
        stage.dataset.wired = "1";
        stage.addEventListener("pointerdown", (e) => {
          if (scale <= 1) return;
          dragging = true;
          stage.classList.add("dragging");
          startX = e.clientX;
          startY = e.clientY;
          startTx = tx;
          startTy = ty;
          e.preventDefault();
        });
        stage.addEventListener("dblclick", (e) => {
          if (scale > 1) {
            resetView(overlay);
            applyTransform(overlay, true);
          } else {
            scale = 2.5;
            applyTransform(overlay, true);
          }
          e.preventDefault();
        });
      }
    }

    document.addEventListener("click", (e) => {
      const target = e.target instanceof Element ? e.target : null;
      if (!target) return;
      if (target.closest(".lightbox")) {
        if (target.closest("[data-lightbox-close]")) close();
        else if (target.closest("[data-lightbox-prev]")) {
          const overlay = getOverlay();
          if (overlay && current > 0) show(overlay, current - 1);
        } else if (target.closest("[data-lightbox-next]")) {
          const overlay = getOverlay();
          if (overlay && current < gallery.length - 1) show(overlay, current + 1);
        }
        return;
      }
      const img = target.closest<HTMLImageElement>("img");
      if (!img) return;
      if (!img.matches(getSelector())) return;
      e.preventDefault();
      e.stopPropagation();
      const imgs = Array.from(document.querySelectorAll<HTMLImageElement>(getSelector()));
      openAt(imgs.indexOf(img));
    });

    document.addEventListener("mouseover", (e) => {
      const target = e.target instanceof Element ? e.target : null;
      const img = target ? target.closest<HTMLImageElement>("img") : null;
      if (img && img.matches(getSelector())) img.classList.add("lightbox-thumb");
    });

    document.addEventListener("keydown", (e) => {
      const overlay = getOverlay();
      if (!overlay || !overlay.classList.contains("open")) return;
      if (e.key === "Escape") {
        e.preventDefault();
        close();
      } else if (e.key === "ArrowLeft") {
        e.preventDefault();
        if (current > 0) show(overlay, current - 1);
      } else if (e.key === "ArrowRight") {
        e.preventDefault();
        if (current < gallery.length - 1) show(overlay, current + 1);
      }
    });

    window.addEventListener(
      "wheel",
      (e) => {
        const overlay = getOverlay();
        if (!overlay || !overlay.classList.contains("open")) return;
        const target = e.target instanceof Element ? e.target : null;
        if (!target || !target.closest(".lightbox-stage")) return;
        e.preventDefault();
        zoom(overlay, e.deltaY < 0 ? 1 : -1);
      },
      { passive: false },
    );

    window.addEventListener("pointermove", (e) => {
      if (!dragging) return;
      tx = startTx + (e.clientX - startX);
      ty = startTy + (e.clientY - startY);
      const overlay = getOverlay();
      if (overlay) applyTransform(overlay, false);
    });

    window.addEventListener("pointerup", () => {
      if (!dragging) return;
      dragging = false;
      const overlay = getOverlay();
      const stage = overlay ? getStage(overlay) : null;
      if (stage) stage.classList.remove("dragging");
    });
  }
</script>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }

  .lightbox:global(.open) {
    display: flex;
  }

  .lightbox:global([hidden]) {
    display: none !important;
  }

  .lightbox-nav[hidden] {
    display: none !important;
  }

  .lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.82);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    animation: lightbox-fade-in 0.25s ease-out;
  }

  @keyframes lightbox-fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .lightbox-toolbar,
  .lightbox-nav {
    position: absolute;
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    border-radius: 9999px;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease;
  }

  .lightbox-toolbar:hover,
  .lightbox-nav:hover {
    background: rgba(255, 255, 255, 0.85);
    color: #111;
    transform: scale(1.06);
  }

  .lightbox-close {
    top: 1rem;
    right: 1rem;
    width: 2.75rem;
    height: 2.75rem;
  }

  .lightbox-close svg {
    width: 1.35rem;
    height: 1.35rem;
  }

  .lightbox-nav {
    top: 50%;
    transform: translateY(-50%);
    width: 3rem;
    height: 3rem;
  }

  .lightbox-nav svg {
    width: 1.6rem;
    height: 1.6rem;
  }

  .lightbox-nav:hover {
    transform: translateY(-50%) scale(1.06);
  }

  .lightbox-prev {
    left: 1rem;
  }
  .lightbox-next {
    right: 1rem;
  }

  .lightbox-counter {
    position: absolute;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 30;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    font-size: 0.85rem;
    white-space: nowrap;
    color: #fff;
    background: rgba(0, 0, 0, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .lightbox-stage {
    position: relative;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 92vw;
    max-height: 88vh;
    border-radius: 0.75rem;
    background: #000;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
    cursor: grab;
    animation: lightbox-zoom-in 0.28s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .lightbox-stage:global(.dragging) {
    cursor: grabbing;
  }

  @keyframes lightbox-zoom-in {
    from {
      opacity: 0;
      transform: scale(0.94);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .lightbox-img {
    display: block;
    max-width: 92vw;
    max-height: 88vh;
    transform-origin: center center;
    will-change: transform;
    user-select: none;
    -webkit-user-drag: none;
  }

  :global(html.lightbox-lock) {
    overflow: hidden;
  }

  :global(.lightbox-thumb) {
    cursor: zoom-in;
  }
</style>
